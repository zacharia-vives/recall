 "fonts": {
  "system": {
   "stack": "\"Segoe UI\", system-ui, -apple-system, Arial, sans-serif",
   "name": "The phone's own",
   "why": "No download, native everywhere.",
   "dl": 0,
   "serif": 0
  },
  "atkinson": {
   "stack": "\"Atkinson Hyperlegible\", \"Segoe UI\", system-ui, sans-serif",
   "name": "Atkinson Hyperlegible",
   "why": "Cut by the Braille Institute to separate letters that blur.",
   "dl": 1,
   "serif": 0
  },
  "lexend": {
   "stack": "\"Lexend\", \"Segoe UI\", system-ui, sans-serif",
   "name": "Lexend",
   "why": "Drawn to lower visual stress while reading.",
   "dl": 1,
   "serif": 0
  },
  "public": {
   "stack": "\"Public Sans\", \"Segoe UI\", system-ui, sans-serif",
   "name": "Public Sans",
   "why": "Built for government forms: plain and wide.",
   "dl": 1,
   "serif": 0
  },
  "literata": {
   "stack": "\"Literata\", Georgia, serif",
   "name": "Literata",
   "why": "A reading serif. Post arrives set in a serif.",
   "dl": 1,
   "serif": 1
  },
  "nunito": {
   "stack": "\"Nunito\", \"Segoe UI\", system-ui, sans-serif",
   "name": "Nunito",
   "why": "Rounded and soft, a little less crisp.",
   "dl": 1,
   "serif": 0
  },
  "archivo": {
   "stack": "\"Archivo\", \"Arial Narrow\", system-ui, sans-serif",
   "name": "Archivo",
   "why": "Squared and sturdy, holds up at a distance.",
   "dl": 1,
   "serif": 0
  },
  "verdana": {
   "stack": "Verdana, Geneva, \"DejaVu Sans\", sans-serif",
   "name": "Verdana",
   "why": "Recommended by low vision guidance for 25 years, and free.",
   "dl": 0,
   "serif": 0
  },
  "georgia": {
   "stack": "Georgia, \"Times New Roman\", serif",
   "name": "Georgia",
   "why": "A serif already on every device, tall x-height.",
   "dl": 0,
   "serif": 1
  },
  "oswald": {
   "stack": "\"Oswald\", \"Arial Narrow\", sans-serif",
   "name": "Oswald",
   "why": "Condensed and loud. Fits more words at a big size.",
   "dl": 1,
   "serif": 0
  },
  "mono": {
   "stack": "\"Roboto Mono\", ui-monospace, Consolas, monospace",
   "name": "Roboto Mono",
   "why": "Every character the same width, so times and codes line up.",
   "dl": 1,
   "serif": 0
  },
  "bitter": {
   "stack": "\"Bitter\", Georgia, serif",
   "name": "Bitter",
   "why": "A slab serif: heavy, sturdy, and very legible at size.",
   "dl": 1,
   "serif": 1
  }
 },
 "layouts": {
  "cards": {
   "name": "Cards",
   "why": "A thumbnail, a title, a line under it. What the app does now."
  },
  "plain": {
   "name": "Plain list",
   "why": "No cards and no thumbnails. Hairline rules and text, like a printed page."
  },
  "stripe": {
   "name": "Stripe",
   "why": "A coloured bar down the left of each row instead of a border."
  },
  "ticket": {
   "name": "Ticket",
   "why": "Dashed edges and a monospace time, like an appointment slip."
  },
  "gutter": {
   "name": "Time gutter",
   "why": "The time in a column of its own on the left, then the entry."
  },
  "notice": {
   "name": "Notice",
   "why": "A shouted label above each entry. Impossible to skim past."
  },
  "one": {
   "name": "One thing",
   "why": "The next thing only, filling the screen, with one enormous button."
  },
  "tiles": {
   "name": "Tiles",
   "why": "Two big squares side by side, a letter and a word each."
  }
 },
